{
  "$defs": {
    "AxisDirection": {
      "enum": [
        "right",
        "left",
        "down",
        "up"
      ],
      "title": "AxisDirection",
      "type": "string"
    },
    "BBoxEdgeConvention": {
      "enum": [
        "continuous",
        "half_open",
        "closed"
      ],
      "title": "BBoxEdgeConvention",
      "type": "string"
    },
    "BBoxMeasurement": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "bbox",
          "default": "bbox",
          "title": "Kind",
          "type": "string"
        },
        "coordinate_space": {
          "title": "Coordinate Space",
          "type": "string"
        },
        "bbox": {
          "$ref": "#/$defs/BBoxXYWHNorm"
        },
        "measurement_role": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Measurement Role"
        }
      },
      "required": [
        "coordinate_space",
        "bbox"
      ],
      "title": "BBoxMeasurement",
      "type": "object"
    },
    "BBoxXYWHNorm": {
      "description": "Canonical TL-normalized bbox: [x, y, w, h] with invariants.",
      "properties": {
        "x": {
          "description": "Left coordinate (0-1, normalized)",
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "X",
          "type": "number"
        },
        "y": {
          "description": "Top coordinate (0-1, normalized)",
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Y",
          "type": "number"
        },
        "w": {
          "description": "Width (0-1, normalized)",
          "exclusiveMinimum": 0.0,
          "maximum": 1.0,
          "title": "W",
          "type": "number"
        },
        "h": {
          "description": "Height (0-1, normalized)",
          "exclusiveMinimum": 0.0,
          "maximum": 1.0,
          "title": "H",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y",
        "w",
        "h"
      ],
      "title": "BBoxXYWHNorm",
      "type": "object"
    },
    "BoundsPolicy": {
      "enum": [
        "reject",
        "clamp",
        "allow"
      ],
      "title": "BoundsPolicy",
      "type": "string"
    },
    "CoordinateOrigin": {
      "enum": [
        "top_left",
        "top_right",
        "bottom_left",
        "bottom_right",
        "cartesian"
      ],
      "title": "CoordinateOrigin",
      "type": "string"
    },
    "CoordinateSpace": {
      "additionalProperties": false,
      "description": "Explicit coordinate interpretation for portable spatial evidence.",
      "properties": {
        "space_id": {
          "title": "Space Id",
          "type": "string"
        },
        "unit": {
          "$ref": "#/$defs/CoordinateUnit"
        },
        "origin": {
          "$ref": "#/$defs/CoordinateOrigin"
        },
        "x_axis": {
          "$ref": "#/$defs/AxisDirection"
        },
        "y_axis": {
          "$ref": "#/$defs/AxisDirection"
        },
        "extent": {
          "$ref": "#/$defs/SpatialExtent"
        },
        "dimensions": {
          "$ref": "#/$defs/RasterDimensions"
        },
        "asset_id": {
          "title": "Asset Id",
          "type": "string"
        },
        "crop_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Crop Id"
        },
        "point_semantics": {
          "$ref": "#/$defs/PointSemantics"
        },
        "bbox_edge_convention": {
          "$ref": "#/$defs/BBoxEdgeConvention"
        },
        "mask_grid_alignment": {
          "$ref": "#/$defs/MaskGridAlignment"
        },
        "bounds_policy": {
          "$ref": "#/$defs/BoundsPolicy"
        },
        "numeric_representation": {
          "$ref": "#/$defs/NumericRepresentation"
        },
        "aliases": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Aliases",
          "type": "array"
        }
      },
      "required": [
        "space_id",
        "unit",
        "origin",
        "x_axis",
        "y_axis",
        "extent",
        "dimensions",
        "asset_id",
        "point_semantics",
        "bbox_edge_convention",
        "mask_grid_alignment",
        "bounds_policy",
        "numeric_representation"
      ],
      "title": "CoordinateSpace",
      "type": "object"
    },
    "CoordinateUnit": {
      "enum": [
        "normalized",
        "pixel"
      ],
      "title": "CoordinateUnit",
      "type": "string"
    },
    "EvidenceFrameReference": {
      "additionalProperties": false,
      "description": "Exact decoded evidence-frame identity.",
      "properties": {
        "media_sha256": {
          "title": "Media Sha256",
          "type": "string"
        },
        "decoded_frame_index": {
          "minimum": 0,
          "title": "Decoded Frame Index",
          "type": "integer"
        },
        "pts": {
          "title": "Pts",
          "type": "integer"
        },
        "pts_time_base": {
          "$ref": "#/$defs/TimeBase"
        },
        "pts_table_sha256": {
          "title": "Pts Table Sha256",
          "type": "string"
        }
      },
      "required": [
        "media_sha256",
        "decoded_frame_index",
        "pts",
        "pts_time_base",
        "pts_table_sha256"
      ],
      "title": "EvidenceFrameReference",
      "type": "object"
    },
    "Invertibility": {
      "enum": [
        "exact",
        "approximate",
        "none"
      ],
      "title": "Invertibility",
      "type": "string"
    },
    "MaskGridAlignment": {
      "enum": [
        "pixel_centers",
        "pixel_edges",
        "continuous"
      ],
      "title": "MaskGridAlignment",
      "type": "string"
    },
    "MaskReference": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "mask",
          "default": "mask",
          "title": "Kind",
          "type": "string"
        },
        "coordinate_space": {
          "title": "Coordinate Space",
          "type": "string"
        },
        "uri": {
          "title": "Uri",
          "type": "string"
        },
        "sha256": {
          "title": "Sha256",
          "type": "string"
        },
        "media_type": {
          "title": "Media Type",
          "type": "string"
        },
        "measurement_role": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Measurement Role"
        }
      },
      "required": [
        "coordinate_space",
        "uri",
        "sha256",
        "media_type"
      ],
      "title": "MaskReference",
      "type": "object"
    },
    "NumericRepresentation": {
      "enum": [
        "float32",
        "float64",
        "integer"
      ],
      "title": "NumericRepresentation",
      "type": "string"
    },
    "ObservationProvenance": {
      "additionalProperties": false,
      "description": "Orthogonal producer and derivation axes with auditable method identity.",
      "properties": {
        "producer": {
          "title": "Producer",
          "type": "string"
        },
        "derivation": {
          "title": "Derivation",
          "type": "string"
        },
        "method": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Method"
        },
        "version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        },
        "source_hashes": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Source Hashes",
          "type": "object"
        }
      },
      "required": [
        "producer",
        "derivation"
      ],
      "title": "ObservationProvenance",
      "type": "object"
    },
    "PointMeasurement": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "point",
          "default": "point",
          "title": "Kind",
          "type": "string"
        },
        "coordinate_space": {
          "title": "Coordinate Space",
          "type": "string"
        },
        "x": {
          "title": "X",
          "type": "number"
        },
        "y": {
          "title": "Y",
          "type": "number"
        },
        "measurement_role": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Measurement Role"
        }
      },
      "required": [
        "coordinate_space",
        "x",
        "y"
      ],
      "title": "PointMeasurement",
      "type": "object"
    },
    "PointSemantics": {
      "enum": [
        "sample",
        "pixel_center",
        "continuous"
      ],
      "title": "PointSemantics",
      "type": "string"
    },
    "Presence": {
      "enum": [
        "present",
        "absent",
        "unknown"
      ],
      "title": "Presence",
      "type": "string"
    },
    "RasterDimensions": {
      "additionalProperties": false,
      "properties": {
        "width": {
          "exclusiveMinimum": 0,
          "title": "Width",
          "type": "integer"
        },
        "height": {
          "exclusiveMinimum": 0,
          "title": "Height",
          "type": "integer"
        }
      },
      "required": [
        "width",
        "height"
      ],
      "title": "RasterDimensions",
      "type": "object"
    },
    "ResolutionStatus": {
      "enum": [
        "resolvable",
        "not_resolvable",
        "not_assessed",
        "unknown"
      ],
      "title": "ResolutionStatus",
      "type": "string"
    },
    "RoundingMode": {
      "enum": [
        "none",
        "floor",
        "ceil",
        "truncate",
        "half_up"
      ],
      "title": "RoundingMode",
      "type": "string"
    },
    "SourceObservationLocator": {
      "additionalProperties": false,
      "description": "Source-authored identity; time is carried, never derived from FPS.",
      "properties": {
        "clip_id": {
          "title": "Clip Id",
          "type": "string"
        },
        "event_id": {
          "title": "Event Id",
          "type": "string"
        },
        "point_index": {
          "minimum": 0,
          "title": "Point Index",
          "type": "integer"
        },
        "frame_index": {
          "minimum": 0,
          "title": "Frame Index",
          "type": "integer"
        },
        "time_sec": {
          "minimum": 0.0,
          "title": "Time Sec",
          "type": "number"
        }
      },
      "required": [
        "clip_id",
        "event_id",
        "point_index",
        "frame_index",
        "time_sec"
      ],
      "title": "SourceObservationLocator",
      "type": "object"
    },
    "SpatialExtent": {
      "additionalProperties": false,
      "description": "Closed coordinate-domain bounds.",
      "properties": {
        "x_min": {
          "title": "X Min",
          "type": "number"
        },
        "y_min": {
          "title": "Y Min",
          "type": "number"
        },
        "x_max": {
          "title": "X Max",
          "type": "number"
        },
        "y_max": {
          "title": "Y Max",
          "type": "number"
        }
      },
      "required": [
        "x_min",
        "y_min",
        "x_max",
        "y_max"
      ],
      "title": "SpatialExtent",
      "type": "object"
    },
    "TaskResolvability": {
      "additionalProperties": false,
      "properties": {
        "localization": {
          "$ref": "#/$defs/ResolutionStatus"
        },
        "segmentation": {
          "$ref": "#/$defs/ResolutionStatus"
        }
      },
      "required": [
        "localization",
        "segmentation"
      ],
      "title": "TaskResolvability",
      "type": "object"
    },
    "TimeBase": {
      "additionalProperties": false,
      "properties": {
        "numerator": {
          "exclusiveMinimum": 0,
          "title": "Numerator",
          "type": "integer"
        },
        "denominator": {
          "exclusiveMinimum": 0,
          "title": "Denominator",
          "type": "integer"
        }
      },
      "required": [
        "numerator",
        "denominator"
      ],
      "title": "TimeBase",
      "type": "object"
    },
    "TransformChain": {
      "additionalProperties": false,
      "description": "Coordinate-space registry plus an ordered, composable step chain.",
      "properties": {
        "spaces": {
          "items": {
            "$ref": "#/$defs/CoordinateSpace"
          },
          "title": "Spaces",
          "type": "array"
        },
        "steps": {
          "items": {
            "$ref": "#/$defs/TransformStep"
          },
          "title": "Steps",
          "type": "array"
        }
      },
      "required": [
        "spaces",
        "steps"
      ],
      "title": "TransformChain",
      "type": "object"
    },
    "TransformStep": {
      "additionalProperties": false,
      "description": "One replayable affine step in an ordered transform chain.\n\n``method`` carries product-compatible labels such as\n``clip-crop-unmap-v1``. The affine matrix, spaces, and numeric policy are\nthe primitive contract.",
      "properties": {
        "from_space": {
          "title": "From Space",
          "type": "string"
        },
        "to_space": {
          "title": "To Space",
          "type": "string"
        },
        "kind": {
          "default": "affine_2d",
          "title": "Kind",
          "type": "string"
        },
        "method": {
          "title": "Method",
          "type": "string"
        },
        "matrix_2x3": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "maxItems": 3,
              "minItems": 3,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "maxItems": 3,
              "minItems": 3,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            }
          ],
          "title": "Matrix 2X3",
          "type": "array"
        },
        "rounding": {
          "$ref": "#/$defs/RoundingMode"
        },
        "bounds_policy": {
          "$ref": "#/$defs/BoundsPolicy"
        },
        "invertibility": {
          "$ref": "#/$defs/Invertibility"
        },
        "round_trip_tolerance": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Round Trip Tolerance"
        }
      },
      "required": [
        "from_space",
        "to_space",
        "method",
        "matrix_2x3",
        "rounding",
        "bounds_policy",
        "invertibility"
      ],
      "title": "TransformStep",
      "type": "object"
    },
    "Visibility": {
      "enum": [
        "visible",
        "partial",
        "occluded",
        "out_of_frame",
        "unknown"
      ],
      "title": "Visibility",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "One portable observation with optional spatial evidence.",
  "properties": {
    "observation_id": {
      "title": "Observation Id",
      "type": "string"
    },
    "subject_id": {
      "title": "Subject Id",
      "type": "string"
    },
    "parent_observation_ids": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Parent Observation Ids",
      "type": "array"
    },
    "presence": {
      "$ref": "#/$defs/Presence"
    },
    "visibility": {
      "$ref": "#/$defs/Visibility"
    },
    "resolvability": {
      "$ref": "#/$defs/TaskResolvability"
    },
    "measurement": {
      "anyOf": [
        {
          "discriminator": {
            "mapping": {
              "bbox": "#/$defs/BBoxMeasurement",
              "mask": "#/$defs/MaskReference",
              "point": "#/$defs/PointMeasurement"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/PointMeasurement"
            },
            {
              "$ref": "#/$defs/BBoxMeasurement"
            },
            {
              "$ref": "#/$defs/MaskReference"
            }
          ]
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Measurement"
    },
    "source_locator": {
      "anyOf": [
        {
          "$ref": "#/$defs/SourceObservationLocator"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "evidence_frame": {
      "anyOf": [
        {
          "$ref": "#/$defs/EvidenceFrameReference"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "transforms": {
      "$ref": "#/$defs/TransformChain"
    },
    "provenance": {
      "$ref": "#/$defs/ObservationProvenance"
    }
  },
  "required": [
    "observation_id",
    "subject_id",
    "presence",
    "visibility",
    "resolvability",
    "transforms",
    "provenance"
  ],
  "title": "SpatialObservation",
  "type": "object"
}
